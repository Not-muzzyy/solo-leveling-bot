# ================================================================
# Solo Leveling Hunter RPG Bot — Environment Configuration
# ================================================================

# Telegram Bot API Token obtained from @BotFather
# 1. Message @BotFather on Telegram (https://t.me/BotFather)
# 2. Run /newbot and follow instructions to name your bot
# 3. Copy the generated API token here:
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram API credentials (required for Kurigram MTProto)
# 1. Go to https://my.telegram.org
# 2. Create an application to get API_ID and API_HASH
API_ID=12345678
API_HASH=your_api_hash_here

# Private Telegram Channel ID used as the persistent database
# 1. Create a new private Telegram channel (e.g., "Hunter Database")
# 2. Add your bot into the channel as an Administrator (with "Post Messages" and "Edit Messages" rights)
DATA_CHANNEL_ID=-1001234567890

# Bot Owner & Superadmin Telegram User IDs
# 1. Message @userinfobot on Telegram to get your numeric User ID
# 2. Set your User ID as OWNER_ID (has root control to /addgold, /addxp, /setlevel, etc.)
OWNER_ID=123456789
# Optional: comma-separated list of additional superadmin user IDs (e.g., 123456789,987654321)
SUPERADMIN_IDS=123456789
